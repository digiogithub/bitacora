{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Bitácora design tokens v0.1 — fuente de verdad. theme.rs y tokens.css se derivan de este fichero.",
  "color": {
    "dark": {
      "side":      { "$type": "color", "$value": "#101114", "$description": "Barra superior y barra lateral izquierda" },
      "bg":        { "$type": "color", "$value": "#141518", "$description": "Fondo del editor / columna principal" },
      "panel":     { "$type": "color", "$value": "#17181C", "$description": "Panel derecho, calendario" },
      "raised":    { "$type": "color", "$value": "#1D1F23", "$description": "Tarjetas, popovers, campo del agente" },
      "hover":     { "$type": "color", "$value": "#25272C", "$description": "Hover / seleccionado neutro, chip LATER, burbuja de usuario" },
      "editBg":    { "$type": "color", "$value": "#1B1D21", "$description": "Fondo del bloque en edición" },
      "line":      { "$type": "color", "$value": "#2A2C32", "$description": "Bordes y líneas guía del outline" },
      "line2":     { "$type": "color", "$value": "#3A3C43", "$description": "Bordes de controles, kbd, chip TODO" },
      "text":      { "$type": "color", "$value": "#E9E7E2" },
      "text2":     { "$type": "color", "$value": "#BDBAB3", "$description": "Texto secundario" },
      "muted":     { "$type": "color", "$value": "#938F88", "$description": "Metadatos, etiquetas (≥4.5:1 sobre bg)" },
      "bullet":    { "$type": "color", "$value": "#6B6963", "$description": "Viñetas de bloque (decorativo)" },
      "accent":    { "$type": "color", "$value": "#72C4CD", "$description": "Enlaces, #tags, [[refs]], selección, DOING/NOW" },
      "accentBg":  { "$type": "color", "$value": "#72C4CD21", "$description": "accent al 13%" },
      "onAccent":  { "$type": "color", "$value": "#0D1A1C" },
      "ai":        { "$type": "color", "$value": "#E2B366", "$description": "SOLO texto/acciones generados por IA aún no aceptados" },
      "aiBg":      { "$type": "color", "$value": "#E2B36612", "$description": "ai al 7%" },
      "aiLine":    { "$type": "color", "$value": "#E2B36647", "$description": "ai al 28%" },
      "onAi":      { "$type": "color", "$value": "#1E1407" },
      "warn":      { "$type": "color", "$value": "#EF9A76", "$description": "Vencido / error suave" },
      "ok":        { "$type": "color", "$value": "#7CC79A", "$description": "MCP activo, tool call correcta" }
    },
    "light": {
      "side":      { "$type": "color", "$value": "#F1EFEA" },
      "bg":        { "$type": "color", "$value": "#FBFAF7" },
      "panel":     { "$type": "color", "$value": "#F6F5F1" },
      "raised":    { "$type": "color", "$value": "#FFFFFF" },
      "hover":     { "$type": "color", "$value": "#EBE9E3" },
      "editBg":    { "$type": "color", "$value": "#F3F1EC" },
      "line":      { "$type": "color", "$value": "#E3E0D9" },
      "line2":     { "$type": "color", "$value": "#CFCCC4" },
      "text":      { "$type": "color", "$value": "#1B1C1F" },
      "text2":     { "$type": "color", "$value": "#44454A" },
      "muted":     { "$type": "color", "$value": "#67655F" },
      "bullet":    { "$type": "color", "$value": "#A3A09A" },
      "accent":    { "$type": "color", "$value": "#1C6A74" },
      "accentBg":  { "$type": "color", "$value": "#1C6A7417", "$description": "accent al 9%" },
      "onAccent":  { "$type": "color", "$value": "#FFFFFF" },
      "ai":        { "$type": "color", "$value": "#8F5608" },
      "aiBg":      { "$type": "color", "$value": "#8F56080D", "$description": "ai al 5%" },
      "aiLine":    { "$type": "color", "$value": "#8F560840", "$description": "ai al 25%" },
      "onAi":      { "$type": "color", "$value": "#FFFFFF" },
      "warn":      { "$type": "color", "$value": "#B0451C" },
      "ok":        { "$type": "color", "$value": "#2F7D4F" }
    }
  },
  "font": {
    "family": {
      "ui":      { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Next", "Segoe UI", "system-ui", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["Literata", "Georgia", "serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Mono", "ui-monospace", "monospace"] }
    }
  },
  "typography": {
    "display":   { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "34px", "fontWeight": 600, "lineHeight": 1.2,  "letterSpacing": "-0.01em" }, "$description": "Título de diario/página" },
    "pageTitle": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "34px", "fontWeight": 600, "lineHeight": 1.2 } },
    "h1Block":   { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "26px", "fontWeight": 600, "lineHeight": 1.3 } },
    "h2Block":   { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "22px", "fontWeight": 600, "lineHeight": 1.35 } },
    "h3Block":   { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "18px", "fontWeight": 600, "lineHeight": 1.4 } },
    "body":      { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.65 }, "$description": "Texto de bloques" },
    "panelBody": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14.5px", "fontWeight": 400, "lineHeight": 1.6 }, "$description": "Panel derecho y agente" },
    "ui":        { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5 } },
    "uiSmall":   { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13.5px", "fontWeight": 400, "lineHeight": 1.5 }, "$description": "Pestañas, botones" },
    "caption":   { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "12.5px", "fontWeight": 400, "lineHeight": 1.45 } },
    "overline":  { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "11.5px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0.08em", "textTransform": "uppercase" }, "$description": "Cabeceras de sección: FAVORITOS, RECIENTES" },
    "mono":      { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.4 }, "$description": "Estados de tarea, fechas, kbd, tool calls" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "2px" },
    "2": { "$type": "dimension", "$value": "4px" },
    "3": { "$type": "dimension", "$value": "6px" },
    "4": { "$type": "dimension", "$value": "8px" },
    "5": { "$type": "dimension", "$value": "10px" },
    "6": { "$type": "dimension", "$value": "12px" },
    "7": { "$type": "dimension", "$value": "16px" },
    "8": { "$type": "dimension", "$value": "20px" },
    "9": { "$type": "dimension", "$value": "24px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "11": { "$type": "dimension", "$value": "56px" }
  },
  "radius": {
    "chip":    { "$type": "dimension", "$value": "5px" },
    "control": { "$type": "dimension", "$value": "8px" },
    "tab":     { "$type": "dimension", "$value": "9px" },
    "card":    { "$type": "dimension", "$value": "10px" },
    "panel":   { "$type": "dimension", "$value": "12px" },
    "popover": { "$type": "dimension", "$value": "14px" },
    "pill":    { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "titlebar":       { "$type": "dimension", "$value": "52px" },
    "sidebarLeft":    { "$type": "dimension", "$value": "252px" },
    "sidebarRight":   { "$type": "dimension", "$value": "360px" },
    "readingMax":     { "$type": "dimension", "$value": "760px" },
    "tasksMax":       { "$type": "dimension", "$value": "860px" },
    "iconButton":     { "$type": "dimension", "$value": "36px" },
    "iconButtonSm":   { "$type": "dimension", "$value": "34px" },
    "tabHeight":      { "$type": "dimension", "$value": "38px" },
    "tabMax":         { "$type": "dimension", "$value": "190px" },
    "navItem":        { "$type": "dimension", "$value": "36px" },
    "bulletGutter":   { "$type": "dimension", "$value": "18px" },
    "bullet":         { "$type": "dimension", "$value": "6px" },
    "bulletChild":    { "$type": "dimension", "$value": "5px" },
    "childIndent":    { "$type": "dimension", "$value": "26px", "$description": "8px margen + 18px padding tras la línea guía" },
    "calendarCell":   { "$type": "dimension", "$value": "32px" },
    "icon":           { "$type": "dimension", "$value": "18px" },
    "iconSm":         { "$type": "dimension", "$value": "15px" },
    "iconStroke":     { "$type": "number",    "$value": 1.7 }
  },
  "shadow": {
    "popover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "40px", "spread": "0px", "color": "#00000047" } }
  }
}
